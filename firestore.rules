rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read public profiles.
    // Writes are restricted to the user's own document.
    // Protected fields such as isAdmin cannot be changed by the client.
    match /users/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'shadowStars',
          'supportWarnings',
          'lastSupportWarning',
          'lastSupportActionAt',
          'supportBlockReason',
          'supportBlockedUntil',
          'accountPermanentlyBlocked',
          'isPremium',
          'premiumUntil',
          'hasGiftEditMessages',
          'hasGiftChangeAvatars',
          'hasGiftGroupTakeover',
          'hasGiftChangeUsernames',
          'hasGiftDoubleGuessAttempts'
        ]);

      allow update: if request.auth != null
        && (
          (
            request.auth.uid == userId
            && (!request.resource.data.keys().hasAny(['customEmojis'])
              || request.resource.data.customEmojis.size() <= (
                request.resource.data.isPremium == true
                  || (
                    request.resource.data.keys().hasAny(['premiumUntil'])
                    && request.resource.data.premiumUntil is timestamp
                    && request.resource.data.premiumUntil > request.time
                  )
                  ? 24 : 12
              ))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'isAdmin',
              'shadowStars',
              'supportWarnings',
              'lastSupportWarning',
              'lastSupportActionAt',
              'supportBlockReason',
              'supportBlockedUntil',
              'accountPermanentlyBlocked',
              'username',
              'userCode',
              'email',
              'createdAt',
              'isPremium',
              'premiumUntil',
              'hasGiftEditMessages',
              'hasGiftChangeAvatars',
              'hasGiftGroupTakeover',
              'hasGiftChangeUsernames',
              'hasGiftDoubleGuessAttempts'
            ])
          )
          ||
          (
            request.auth.uid != userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl'])
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasGiftChangeAvatars == true
          )
        );

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageTime',
          'chatBackgroundUrl',
          'chatBackgroundColor',
          'chatListColor',
          'chatListDecoration'
        ])
        || (
          request.auth != null
          && request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'unread_\$(request.auth.uid)'
          ])
        );

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
          && request.resource.data.edited == true
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasGiftEditMessages == true;

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /usedPromoCodes/{docId} {
      allow read, write: if false;
    }

    match /gameStats/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tickets/{ticketId} {
      allow read: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerUid == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          );
        allow create, update, delete: if false;
      }
    }
  }
}
