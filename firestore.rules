rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read public profiles.
    // Writes are restricted to the user's own document.
    // Protected fields such as isAdmin cannot be changed by the client.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'shadowStars',
          'supportWarnings',
          'lastSupportWarning',
          'lastSupportActionAt',
          'supportBlockReason',
          'supportBlockedUntil',
          'accountPermanentlyBlocked',
          'isPremium',
          'premiumUntil',
          'hasGiftEditMessages',
          'hasGiftChangeAvatars',
          'hasGiftGroupTakeover',
          'hasGiftChangeUsernames',
          'hasGiftDoubleGuessAttempts'
        ]);

      allow update: if request.auth != null
        && (
          (
            request.auth.uid == userId
            && (!request.resource.data.keys().hasAny(['customEmojis'])
              || request.resource.data.customEmojis.size() <= (
                request.resource.data.isPremium == true
                  || (
                    request.resource.data.keys().hasAny(['premiumUntil'])
                    && request.resource.data.premiumUntil is timestamp
                    && request.resource.data.premiumUntil > request.time
                  )
                  ? 24 : 12
              ))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'isAdmin',
              'shadowStars',
              'supportWarnings',
              'lastSupportWarning',
              'lastSupportActionAt',
              'supportBlockReason',
              'supportBlockedUntil',
              'accountPermanentlyBlocked',
              'username',
              'userCode',
              'email',
              'createdAt',
              'isPremium',
              'premiumUntil',
              'hasGiftEditMessages',
              'hasGiftChangeAvatars',
              'hasGiftGroupTakeover',
              'hasGiftChangeUsernames',
              'hasGiftDoubleGuessAttempts'
            ])
          )
          ||
          (
            request.auth.uid != userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl'])
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasGiftChangeAvatars == true
          )
        );

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() > 0
        && request.auth.uid in request.resource.data.participants;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageTime',
          'chatBackgroundUrl',
          'chatBackgroundColor',
          'chatListColor',
          'unreadVersion',
          'chatListDecoration'
        ]);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId
          && request.resource.data.read == false;

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && (
            (
              resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
              && request.resource.data.edited == true
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasGiftEditMessages == true
            )
            ||
            (
              resource.data.senderId != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
              && request.resource.data.read == true
            )
          );

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && resource.data.senderId == request.auth.uid;
      }
    }

    // One unread document belongs to exactly one recipient.
    // This replaces the old unread_<uid> fields on chats, which allowed the
    // sender client to try to mutate another user's counter.
    match /chatUnread/{unreadId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'chatId',
          'messageId',
          'userId',
          'senderId'
        ])
        && request.resource.data.chatId is string
        && request.resource.data.messageId is string
        && request.resource.data.userId is string
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.userId != request.auth.uid
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.participants
        && request.resource.data.userId in get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.participants
        && get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)
        ).data.senderId == request.auth.uid
        && get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)
        ).data.chatId == request.resource.data.chatId
        && get(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)
        ).data.read == false;

      allow update: if false;
      allow delete: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || (
            resource.data.senderId == request.auth.uid
            && !existsAfter(
              /databases/$(database)/documents/chats/$(resource.data.chatId)/messages/$(resource.data.messageId)
            )
          )
        );
    }

    match /usedPromoCodes/{docId} {
      allow read, write: if false;
    }

    match /gameStats/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tickets/{ticketId} {
      allow read: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerUid == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          );
        allow create, update, delete: if false;
      }
    }
  }
}
