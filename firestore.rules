rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read public profiles.
    // Writes are restricted to the user's own document.
    // Protected fields such as isAdmin cannot be changed by the client.
    match /users/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'shadowStars',
          'supportWarnings',
          'lastSupportWarning',
          'lastSupportActionAt',
          'supportBlockReason',
          'supportBlockedUntil',
          'accountPermanentlyBlocked'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin',
          'shadowStars',
          'supportWarnings',
          'lastSupportWarning',
          'lastSupportActionAt',
          'supportBlockReason',
          'supportBlockedUntil',
          'accountPermanentlyBlocked'
        ]);

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow create: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /usedPromoCodes/{docId} {
      allow read, write: if false;
    }

    match /gameStats/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tickets/{ticketId} {
      allow read: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerUid == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          );
        allow create, update, delete: if false;
      }
    }
  }
}
